<span class="expenses-summary">
    <img src="images/info-circle.svg" alt="Info circle" data-bs-toggle="tooltip" data-bs-title="Summary"/>
    <div class="expenses-summary__popup home__level-2">
        <div class="expenses-summary__popup__expense">
            @{ var total = 0F; }
            @foreach (ExpensesItem expense in Item.Items)
            {
                <div class="expenses-summary__popup__expense__item">
                    <div class="text-decoration-underline">@SetPriceText(expense)</div>
                    <div class="expenses-summary__popup__expense__item__new-price">@SetUpdatedPrice(expense, ref total)</div>
                </div>
            }
        </div>
    </div>
</span>

@code {

    [Parameter] public required Expenses Item { get; set; }
    [Parameter] public required int Month { get; set; }
    [Parameter] public required string ListCurrency { get; set; }

    private string SetPriceText(ExpensesItem expense)
    {
        return expense.Name + ": " + $"{expense.CountedDaysInAMonth} * {expense.Price} = {Month} * {expense.CountedDaysInAMonth * expense.Price} * {expense.GetCurrencyMultiplier()} ÷ {GetCurrencyDivider(expense)}" + " = " + $"{(expense.GetItemTotalPriceAndConvertToListCurrency(ListCurrency) * Month):0.00}";
    }

    private string SetUpdatedPrice(ExpensesItem expense, ref float total)
    {
        return $"• {total:0.00} + {(expense.GetItemTotalPriceAndConvertToListCurrency(ListCurrency) * Month):0.00} = {(total += expense.GetItemTotalPriceAndConvertToListCurrency(ListCurrency) * Month):0.00}{Item.GetCurrencySymbol()}";
    }

    private string GetCurrencyDivider(ExpensesItem expense)
    {
        return expense.Currency == ListCurrency ? "1" : expense.GetCurrencyMultiplier(ListCurrency).ToString("0.00");
    }
}