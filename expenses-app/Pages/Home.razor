@page "/"
@inject ExpensesService ExpenseService
@inject IJSRuntime JsRuntime

<div class="home">
    <div class="home__new-expense home__level-1">
        <h2>New Expense</h2>
        <EditForm Model="@_newExpense" OnValidSubmit="AddNewExpense">
            <ValidationSummary/>
            <ObjectGraphDataAnnotationsValidator/>
            <div class="form-group mb-2">
                <div class="row">
                    <div class="col-6">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_newExpense.Name"/>
                    </div>
                    <div class="col-6">
                        <label>Currency</label>
                        <InputSelect class="form-control" @bind-Value="_newExpense.Currency">
                            <option value="DKK">DKK</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
            <div>
                @foreach (var item in _newExpense.Items)
                {
                    <div class="home__level-2 mb-2">
                        <div class="d-flex gap-2 mb-2">
                            <InputText class="form-control" @bind-Value="item.Name"/>
                            <InputNumber class="form-control" TValue="float" @bind-Value="item.Price"/>
                            <button class="btn btn-danger" type="button" @onclick="() => RemoveNewItem(item)">
                                X
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <SelectCountedDaysInAMonth Item="@item" OnChanged="ChangeState"/>
                            <InputSelect class="form-control home__expenses__expense__title"
                                         @bind-Value="item.Currency">
                                <option value="DKK">DKK</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </InputSelect>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between">
                <button class="btn btn-secondary" type="button" @onclick="AddNewItem">
                    Add Item
                </button>
                <button class="btn btn-primary" type="submit">
                    Save
                </button>
            </div>
        </EditForm>
    </div>

    <div class="home__expenses home__level-1">
        <h2>All Expenses</h2>
        @foreach (var expense in _allExpenses)
        {
            <div class="home__expenses__expense home__level-2">
                <div class="mb-2 d-flex">
                    <InputText disabled="@(_disabledExpensesNames.Contains(expense))"
                               class="form-control home__expenses__expense__title"
                               @bind-Value="expense.Name"/>
                    @{ var expenseId = $"expense-{Guid.NewGuid()}"; }
                    <InputSelect disabled="@(_disabledExpensesNames.Contains(expense))"
                                 class="form-control home__expenses__expense__title"
                                 @bind-Value="expense.Currency">
                        <option value="DKK">DKK</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </InputSelect>
                    <button class="btn btn-secondary home__expenses__expense__disable-btn" type="button"
                            @onclick="() => ToggleExpenseTitle(expense, expenseId)">
                        <i class="bi bi-pencil-square" id="@expenseId"></i>
                    </button>
                </div>
                @foreach (var item in expense.Items)
                {
                    <div class="home__level-3 mb-2">
                        <div class="d-flex gap-2 mb-2">
                            <InputText class="form-control" @bind-Value="item.Name"/>
                            <InputNumber class="form-control" TValue="float" @bind-Value="item.Price"/>
                        </div>
                        <div class="d-flex gap-2">
                            <SelectCountedDaysInAMonth Item="@item" OnChanged="ChangeState"/>
                            <InputSelect class="form-control home__expenses__expense__title"
                                         @bind-Value="item.Currency">
                                <option value="DKK">DKK</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </InputSelect>
                            <button class="btn btn-danger" type="button"
                                    @onclick="() => RemoveExpenseItem(expense, item)">
                                X
                            </button>
                            <button class="btn btn-success" type="button"
                                    @onclick="() => AddExpenseItemToExisting(expense)">
                                +
                            </button>
                        </div>
                    </div>
                }

                <div class="home__expenses__expense__total">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Month:
                                <span
                                    class="home__expenses__expense__total__price">@expense.GetMonthlyPrice().ToString(".00")@expense.GetCurrencySymbol()</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Quarter:
                                <span
                                    class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 3).ToString(".00"))@expense.GetCurrencySymbol()</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Semiannual:
                                <span
                                    class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 6).ToString(".00"))@expense.GetCurrencySymbol()</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Annual:
                                <span
                                    class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 12).ToString(".00"))@expense.GetCurrencySymbol()</span>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-dark" type="button" @onclick="() => RemoveExpense(expense)">
                    Remove Expense
                </button>
            </div>
        }
    </div>

    <div class="home__level-1">
        <div class="row">
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Month: <span class="home__expenses__expense__total__price">@_totalMonthlyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Quarter: <span
                        class="home__expenses__expense__total__price">@_totalQuarterlyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Semiannual: <span
                        class="home__expenses__expense__total__price">@_totalSemiAnnuallyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Annual: <span class="home__expenses__expense__total__price">@_totalAnnuallyMoneyStr</span>
                </div>
            </div>
        </div>
        <InputSelect class="form-control" @bind-Value="_currentCurrency" @onclick="PrintTotalMoney">
            <option value="DKK">DKK</option>
            <option value="USD">USD</option>
            <option value="EUR">EUR</option>
        </InputSelect>
    </div>

    <button class="btn btn-primary" type="button" @onclick="UpdateAllExpenses">
        Update All Expenses
    </button>

    <button class="btn btn-success" type="button" @onclick="ExportExpenses">
        Export expenses
    </button>

    <button class="btn btn-warning" type="button" @onclick="ImportExpenses">
        Import expenses
    </button>
</div>

@code {

    private List<Expenses> _allExpenses = [];
    private Expenses _newExpense = new();
    private HashSet<Expenses> _disabledExpensesNames = [];
    private float _totalMoney = 0;
    private string _totalMonthlyMoneyStr = "";
    private string _totalQuarterlyMoneyStr = "";
    private string _totalSemiAnnuallyMoneyStr = "";
    private string _totalAnnuallyMoneyStr = "";
    private string _currentCurrency = "DKK";

    protected override async Task OnInitializedAsync()
    {
        var expenses = await ExpenseService.GetExpenses();
        if (expenses == null)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No expenses found");
            return;
        }

        _allExpenses = expenses;

        foreach (var expense in _allExpenses)
        {
            expense.PrintExpenses();
            _disabledExpensesNames.Add(expense);
        }

        PrintTotalMoney();
    }
    
    public void ChangeState() => StateHasChanged();

    private void PrintTotalMoney()
    {
        float multiplier = 1;
        string symbol = "";
        _totalMoney = 0;
        if (_currentCurrency == "DKK")
        {
            multiplier = 1;
            symbol = ",-kr";
        }
        else if (_currentCurrency == "EUR")
        {
            multiplier = 7.45f;
            symbol = ",-€";
        }
        else if (_currentCurrency == "USD")
        {
            multiplier = 6.5f;
            symbol = ",-$";
        }

        foreach (var expense in _allExpenses)
        {
            _totalMoney += expense.SumPrice(multiplier);
        }

        _totalMonthlyMoneyStr = _totalMoney.ToString(".00") + symbol;
        _totalQuarterlyMoneyStr = (_totalMoney * 3).ToString(".00") + symbol;
        _totalSemiAnnuallyMoneyStr = (_totalMoney * 6).ToString(".00") + symbol;
        _totalAnnuallyMoneyStr = (_totalMoney * 12).ToString(".00") + symbol;
        StateHasChanged();
    }

    private async Task ToggleExpenseTitle(Expenses expense, string expenseName)
    {
        if (!_disabledExpensesNames.Add(expense))
            _disabledExpensesNames.Remove(expense);
        await JsRuntime.InvokeVoidAsync("window.shakeElement", expenseName);
    }

    private async Task AddNewExpense()
    {
        _allExpenses.Add(_newExpense);
        await ExpenseService.UpdateAllExpenses(_allExpenses);
        _newExpense = new Expenses();
        PrintTotalMoney();
    }

    private void AddNewItem() => _newExpense.Items.Add(new ExpensesItem { Name = "", Price = 0 });

    private void RemoveExpense(Expenses expense)
    {
        _allExpenses.Remove(expense);
        PrintTotalMoney();
    }

    private void RemoveExpenseItem(Expenses expense, ExpensesItem item)
    {
        expense.Items.Remove(item);
        PrintTotalMoney();
    }

    private async Task UpdateAllExpenses()
    {
        await ExpenseService.UpdateAllExpenses(_allExpenses);
        PrintTotalMoney();
    }

    private void RemoveNewItem(ExpensesItem item)
    {
        _newExpense.Items.Remove(item);
    }

    private void AddExpenseItemToExisting(Expenses expense) => expense.Items.Add(new ExpensesItem { Name = "", Price = 0 });
    private async Task ExportExpenses() => await ExpenseService.ExportExpenses();
    private async Task ImportExpenses() => await ExpenseService.ImportExpenses();
}