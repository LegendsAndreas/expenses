@page "/"
@inject ApiService ApiService
@inject ExpensesService ExpenseService
@inject IJSRuntime JsRuntime

<div class="home">
    <div class="home__new-expense home__level-1">
        <h2>New Expense</h2>
        <EditForm Model="@_newExpense" OnValidSubmit="AddNewExpense">
            <ValidationSummary/>
            <ObjectGraphDataAnnotationsValidator/>
            <div class="form-group mb-2">
                <div class="row">
                    <div class="col-6">
                        <label>Name</label>
                        <InputText class="form-control" @bind-Value="_newExpense.Name"/>
                    </div>
                    <div class="col-6">
                        <label>Currency</label>
                        <InputSelect class="form-control" @bind-Value="_newExpense.Currency">
                            <option value="DKK">DKK</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
            @{ string containerId = $"expense-container-{Guid.NewGuid()}"; }
            <div class="js-set-height home__new-expense__form-group" id="@containerId">
                @foreach (var item in _newExpense.Items)
                {
                    var itemId = $"new-expense-item-{Guid.NewGuid()}";
                    <div class="home__level-2 mb-2" id="@itemId">
                        <div class="d-flex gap-2 mb-2">
                            <InputText class="form-control" @bind-Value="item.Name"/>
                            <InputNumber class="form-control" TValue="float" @bind-Value="item.Price"/>
                            <button class="btn btn-danger" type="button"
                                    @onclick="() => RemoveNewExpense(item, itemId, containerId)">
                                X
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <SelectCountedDaysInAMonth Item="@item" OnChanged="ChangeState"/>
                            <InputSelect class="form-control home__expenses__expense__title"
                                         @bind-Value="item.Currency">
                                <option value="DKK">DKK</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </InputSelect>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between">
                <button class="btn btn-success" type="button" @onclick="AddNewItem">
                    + Add Expense
                </button>
                <button class="btn btn-primary" type="submit">
                    Save
                </button>
            </div>
        </EditForm>
    </div>

    <div class="home__expenses home__level-1">
        <h2>All Expenses</h2>
        @{
            int currentExpense = 0;
        }
        @foreach (Expenses expense in _allExpenses)
        {
            int expenseIndex = currentExpense++; // Capture the current value
            Guid guid = Guid.NewGuid();
            string containerId = $"expense-container-{guid}";
            <div class="home__expenses__expense home__level-2">
                <div class="mb-2 d-flex js-init-adjust-input-size">
                    <InputText disabled="@(_disabledExpensesNames.Contains(expense))"
                               class="form-control home__expenses__expense__title js-init-adjust-input-size-input"
                               @oninput="() => AdjustInputSize(expenseIndex)"
                               id="@($"expenses-{expenseIndex}")"
                               @bind-Value="expense.Name"/>
                    <span class="home__expenses__expense__input-span js-init-adjust-input-size-span"
                          id="@($"span-{expenseIndex}")"></span>
                    @{ string expenseId = $"expense-{Guid.NewGuid()}"; }
                    <InputSelect disabled="@(_disabledExpensesNames.Contains(expense))"
                                 class="form-control home__expenses__expense__title"
                                 @bind-Value="expense.Currency">
                        <option value="DKK">DKK</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </InputSelect>
                    <button class="btn btn-secondary home__expenses__expense__disable-btn" type="button"
                            @onclick="() => ToggleExpenseTitle(expense, expenseId)">
                        <img src="images/pencil-square.svg" alt="Pencil square..." id="@expenseId"
                             style="filter: invert(1);"/>
                    </button>
                </div>
                <div class="home__expenses__expense__item js-set-height" id="@containerId">
                    @foreach (ExpensesItem item in expense.Items)
                    {
                        var itemId = $"new-expense-item-{Guid.NewGuid()}";
                        <div class="home__level-3 mb-2" id="@itemId">
                            <div class="d-flex gap-2 mb-2">
                                <InputText class="form-control" @bind-Value="item.Name"/>
                                <InputNumber class="form-control" TValue="float" @bind-Value="item.Price"/>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <SelectCountedDaysInAMonth Item="@item" OnChanged="ChangeState"/>
                                <InputSelect class="form-control home__expenses__expense__select"
                                             @bind-Value="item.Currency">
                                    <option value="DKK">DKK</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </InputSelect>
                                <button class="btn btn-danger" type="button"
                                        @onclick="() => RemoveExpenseItemFromExpenseList(expense, item, itemId, containerId)">
                                    X
                                </button>
                                <button class="btn btn-success" type="button"
                                        @onclick="() => AddExpenseItemToExisting(expense)">
                                    +
                                </button>
                                @if (!string.IsNullOrEmpty(item.Currency))
                                {
                                    <div class="form-control w-auto d-flex align-items-center">
                                        <img src="images/cash-stack.svg" class="home__expenses__expense__item__cash"
                                             alt="Cash stack"/>
                                        @item.GetItemTotalPriceAndConvertToListCurrency(expense.Currency).ToString("0.00")
                                    </div>
                                }
                                <RealTimeSearchRecipes
                                    CurrentRecipeDataHasChanged="@(value => AddRecipeCostToExpense(value, item))"/>
                            </div>
                        </div>
                    }
                </div>

                <div class="home__expenses__expense__total">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Month:
                                <span>
                                    <span
                                        class="home__expenses__expense__total__price">@expense.GetMonthlyPrice().ToString(".00")@expense.GetCurrencySymbol()</span>
                                    <ExpensesSummaryPopup Month="1" Item="expense" ListCurrency="@expense.Currency"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Quarter:
                                <span>
                                    <span
                                        class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 3).ToString(".00"))@expense.GetCurrencySymbol()</span>
                                    <ExpensesSummaryPopup Month="3" Item="expense" ListCurrency="@expense.Currency"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Semiannual:
                                <span>
                                    <span
                                        class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 6).ToString(".00"))@expense.GetCurrencySymbol()</span>
                                    <ExpensesSummaryPopup Month="6" Item="expense" ListCurrency="@expense.Currency"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                            <div class="home__expenses__expense__total">
                                Annual:
                                <span>
                                    <span
                                        class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 12).ToString(".00"))@expense.GetCurrencySymbol()</span>
                                    <ExpensesSummaryPopup Month="12" Item="expense" ListCurrency="@expense.Currency"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-dark" type="button" @onclick="() => RemoveExpense(expense)">
                    Remove Expense
                </button>
            </div>
        }
    </div>

    <div class="home__level-1">
        <div class="row">
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Month: <span class="home__expenses__expense__total__price">@_totalMonthlyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Quarter: <span
                        class="home__expenses__expense__total__price">@_totalQuarterlyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Semiannual: <span
                        class="home__expenses__expense__total__price">@_totalSemiAnnuallyMoneyStr</span>
                </div>
            </div>
            <div class="col-12 col-xs-6 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                <div class="home__expenses__expense__total">
                    Annual: <span class="home__expenses__expense__total__price">@_totalAnnuallyMoneyStr</span>
                </div>
            </div>
        </div>
        <InputSelect class="form-control" @bind-Value="_currentCurrency" @onclick="PrintTotalMoney">
            <option value="DKK">DKK</option>
            <option value="USD">USD</option>
            <option value="EUR">EUR</option>
        </InputSelect>
    </div>

    @*Without changing too much of the same code, we still loop through as list, even tho we dont need to. 
    We might also need to do so in the future anyway*@
    @if (_currentDailyExpense == null)
    {
        <button class="btn btn-primary" type="button" @onclick="StartNewDailyExpense">New Daily Expense</button>
    }
    else
    {
        <div class="home__expenses home__level-1">
            <h2>Daily Expenses</h2>
            @{
                int currentDailyExpenses = 0;
            }
            @foreach (Expenses expense in _currentDailyExpense)
            {
                int expenseIndex = currentDailyExpenses++; // Capture the current value
                Guid guid = Guid.NewGuid();
                string containerId = $"expense-container-{guid}";
                <div class="home__expenses__expense home__level-2">
                    <div class="mb-2 d-flex js-init-adjust-input-size">
                        <InputText disabled="true"
                                   class="form-control home__expenses__expense__title js-init-adjust-input-size-input"
                                   @oninput="() => AdjustInputSize(expenseIndex)"
                                   id="@($"expenses-{expenseIndex}")"
                                   @bind-Value="expense.Name"/>
                        <span class="home__expenses__expense__input-span js-init-adjust-input-size-span"
                              id="@($"span-{expenseIndex}")"></span>
                        @{ string expenseId = $"expense-{Guid.NewGuid()}"; }
                        <InputSelect disabled="@(_disabledExpensesNames.Contains(expense))"
                                     class="form-control home__expenses__expense__title"
                                     @bind-Value="expense.Currency">
                            <option value="DKK">DKK</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </InputSelect>
                        <button class="btn btn-secondary home__expenses__expense__disable-btn" type="button"
                                @onclick="() => ToggleExpenseTitle(expense, expenseId)">
                            <img src="images/pencil-square.svg" alt="Pencil square..." id="@expenseId"
                                 style="filter: invert(1);"/>
                        </button>
                    </div>
                    <div class="home__expenses__expense__item js-set-height" id="@containerId">
                        @foreach (ExpensesItem item in expense.Items)
                        {
                            var itemId = $"new-expense-item-{Guid.NewGuid()}";
                            <div class="home__level-3 mb-2" id="@itemId">
                                <div class="d-flex gap-2 mb-2">
                                    <InputText class="form-control" @bind-Value="item.Name"/>
                                    <InputNumber class="form-control" TValue="float" @bind-Value="item.Price"/>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <SelectCountedDaysInAMonth Item="@item" OnChanged="ChangeState"/>
                                    <InputSelect class="form-control home__expenses__expense__select"
                                                 @bind-Value="item.Currency">
                                        <option value="DKK">DKK</option>
                                        <option value="USD">USD</option>
                                        <option value="EUR">EUR</option>
                                    </InputSelect>
                                    <button class="btn btn-danger" type="button"
                                            @onclick="() => RemoveExpenseItemFromExpenseList(expense, item, itemId, containerId)">
                                        X
                                    </button>
                                    <button class="btn btn-success" type="button"
                                            @onclick="() => AddExpenseItemToExisting(expense)">
                                        +
                                    </button>
                                    @if (!string.IsNullOrEmpty(item.Currency))
                                    {
                                        <div class="form-control w-auto d-flex align-items-center">
                                            <img src="images/cash-stack.svg" class="home__expenses__expense__item__cash"
                                                 alt="Cash stack"/>
                                            @item.GetItemTotalPriceAndConvertToListCurrency(expense.Currency).ToString("0.00")
                                        </div>
                                    }
                                    <RealTimeSearchRecipes
                                        CurrentRecipeDataHasChanged="@(value => AddRecipeCostToExpense(value, item))"/>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="home__expenses__expense__total">
                        <div class="row">
                            <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                                <div class="home__expenses__expense__total">
                                    Month:
                                    <span>
                                        <span
                                            class="home__expenses__expense__total__price">@expense.GetMonthlyPrice().ToString("0.00")@expense.GetCurrencySymbol()</span>
                                        <ExpensesSummaryPopup Month="1" Item="expense"
                                                              ListCurrency="@expense.Currency"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                                <div class="home__expenses__expense__total">
                                    Quarter:
                                    <span>
                                        <span
                                            class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 3).ToString("0.00"))@expense.GetCurrencySymbol()</span>
                                        <ExpensesSummaryPopup Month="3" Item="expense"
                                                              ListCurrency="@expense.Currency"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                                <div class="home__expenses__expense__total">
                                    Semiannual:
                                    <span>
                                        <span
                                            class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 6).ToString("0.00"))@expense.GetCurrencySymbol()</span>
                                        <ExpensesSummaryPopup Month="6" Item="expense"
                                                              ListCurrency="@expense.Currency"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 col-lg-3 home__expenses__expense__total__mobile">
                                <div class="home__expenses__expense__total">
                                    Annual:
                                    <span>
                                        <span
                                            class="home__expenses__expense__total__price">@((expense.GetMonthlyPrice() * 12).ToString("0.00"))@expense.GetCurrencySymbol()</span>
                                        <ExpensesSummaryPopup Month="12" Item="expense"
                                                              ListCurrency="@expense.Currency"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-dark" type="button" @onclick="() => RemoveDailyExpense()">
                        Remove Daily expense
                    </button>
                </div>
            }
        </div>
    }

    <button class="btn btn-primary" type="button" @onclick="UpdateAllExpenses">
        Update Expenses
    </button>

    <div class="d-flex gap-2">
        <button class="btn btn-success w-50" type="button" @onclick="ExportExpenses">
            Export expenses
        </button>
        <button class="btn btn-warning w-50" type="button" @onclick="() => EnterDateModal(true)">
            Export daily expenses
        </button>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-success w-50" type="button" @onclick="ImportExpenses">
            Import expenses
        </button>
        <button class="btn btn-warning w-50" type="button" @onclick="() => EnterDateModal(false)">
            Import daily expenses
        </button>
    </div>
</div>

<div class="modal fade" id="enterDate" tabindex="-1" aria-labelledby="areYouSure" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="areYouSure">Enter date</h5>
                <InputDate @bind-Value="_dateToGetDailyExpenses"></InputDate>
            </div>
            <div class="modal-body">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" aria-label="Close">Close</button>
                @if (_isExporting)
                {
                    <button class="btn btn-primary" data-bs-dismiss="modal" @onclick="ExportDailyExpenses">Export
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" data-bs-dismiss="modal" @onclick="ImportDailyExpenses">Import
                    </button>
                }

            </div>
        </div>
    </div>
</div>

<script>
    function showEnterDateModal() {
        const modalElement = document.getElementById("enterDate");
        const modalInstance = new bootstrap.Modal(modalElement);
        modalInstance.show();
    }
</script>

@code {

    private List<Expenses> _allExpenses = [];
    private Expenses _newExpense = new();
    private HashSet<Expenses> _disabledExpensesNames = [];
    private float _totalMoney = 0;
    private string _totalMonthlyMoneyStr = "";
    private string _totalQuarterlyMoneyStr = "";
    private string _totalSemiAnnuallyMoneyStr = "";
    private string _totalAnnuallyMoneyStr = "";
    private string _currentCurrency = "DKK";
    private bool _setHeight = false;
    private readonly DateOnly _currentDate = DateOnly.FromDateTime(DateTime.Now);
    private List<Expenses>? _currentDailyExpense;
    private DateOnly _dateToGetDailyExpenses = DateOnly.FromDateTime(DateTime.Now);
    private bool _isExporting = true;

    protected override async Task OnInitializedAsync()
    {
        var expenses = await ExpenseService.GetExpenses();
        if (expenses == null)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No expenses found");
            return;
        }

        _allExpenses = expenses;

        var dailyExpenses = await ExpenseService.GetDailyExpenses(_currentDate);
        if (dailyExpenses != null)
        {
            _currentDailyExpense = dailyExpenses;

            foreach (var expense in _currentDailyExpense)
            {
                _disabledExpensesNames.Add(expense);
            }
        }

        foreach (var expense in _allExpenses)
        {
            _disabledExpensesNames.Add(expense);
        }

        PrintTotalMoney();
        await JsRuntime.InvokeVoidAsync("setHeight");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JsRuntime.InvokeVoidAsync("initAdjustInputSize");
        if (_setHeight)
        {
            await JsRuntime.InvokeVoidAsync("setHeight");
            _setHeight = false;
        }

        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("initSummaryPopupClamping");
        }
    }

    public void ChangeState() => StateHasChanged();

    private async Task AdjustInputSize(int id)
    {
        await JsRuntime.InvokeVoidAsync("adjustInputSize", id);
        StateHasChanged();
    }

    private void PrintTotalMoney()
    {
        float multiplier = 1;
        string symbol = "";
        _totalMoney = 0;
        if (_currentCurrency == "DKK")
        {
            multiplier = 1;
            symbol = ",-kr";
        }
        else if (_currentCurrency == "EUR")
        {
            multiplier = 7.45f;
            symbol = ",-€";
        }
        else if (_currentCurrency == "USD")
        {
            multiplier = 6.5f;
            symbol = ",-$";
        }

        foreach (var expense in _allExpenses)
        {
            _totalMoney += expense.SumPrice(multiplier);
        }

        _totalMonthlyMoneyStr = _totalMoney.ToString("0.00") + symbol;
        _totalQuarterlyMoneyStr = (_totalMoney * 3).ToString(".00") + symbol;
        _totalSemiAnnuallyMoneyStr = (_totalMoney * 6).ToString(".00") + symbol;
        _totalAnnuallyMoneyStr = (_totalMoney * 12).ToString(".00") + symbol;
        StateHasChanged();
    }

    private async Task ToggleExpenseTitle(Expenses expense, string expenseName)
    {
        if (!_disabledExpensesNames.Add(expense))
            _disabledExpensesNames.Remove(expense);
        await JsRuntime.InvokeVoidAsync("window.shakeElement", expenseName);
    }

    private async Task AddNewExpense()
    {
        _allExpenses.Add(_newExpense);
        await ExpenseService.UpdateExpenses(_allExpenses);
        _newExpense = new Expenses();
        PrintTotalMoney();
        _setHeight = true;
    }

    private void AddNewItem()
    {
        _newExpense.Items.Add(new ExpensesItem { Name = "", Price = 0 });
        _setHeight = true;
    }

    private void RemoveExpense(Expenses expense)
    {
        _allExpenses.Remove(expense);
        PrintTotalMoney();
    }

    private void RemoveDailyExpense()
    {
        _currentDailyExpense = null;
        PrintTotalMoney();
    }

    private async Task RemoveExpenseItemFromExpenseList(Expenses expense, ExpensesItem item, string itemId, string containerId)
    {
        expense.Items.Remove(item);
        await JsRuntime.InvokeVoidAsync("removeExpenseButton", itemId, containerId);
        PrintTotalMoney();
    }

    private async Task UpdateAllExpenses()
    {
        await ExpenseService.UpdateAllExpenses(_allExpenses, _currentDailyExpense);
        PrintTotalMoney();
    }

    private async Task RemoveNewExpense(ExpensesItem item, string itemId, string containerId)
    {
        _newExpense.Items.Remove(item);
        await JsRuntime.InvokeVoidAsync("removeExpenseButton", itemId, containerId);
    }

    private void AddExpenseItemToExisting(Expenses expense)
    {
        expense.Items.Add(new ExpensesItem { Name = "", Price = 0 });
        _setHeight = true;
    }

    private void AddRecipeCostToExpense(Recipe recipe, ExpensesItem item)
    {
        item.Name = recipe.Name;
        item.Price = recipe.Cost;
    }

    private void StartNewDailyExpense()
    {
        _currentDailyExpense = new()
        {
            new Expenses()
            {
                Name = DateOnly.FromDateTime(DateTime.Now).ToString("dd-MM-yyyy"),
                Currency = "DKK",
                Items = new List<ExpensesItem>
                {
                    new ExpensesItem { Name = "New", Currency = "DKK", CountedDaysInAMonth = 1, Price = 0 },
                }
            }
        };
        _setHeight = true;
    }

    private async Task ExportExpenses() => await ExpenseService.ExportExpenses();

    private async Task EnterDateModal(bool isExporting)
    {
        _isExporting = isExporting;
        await JsRuntime.InvokeVoidAsync("showEnterDateModal");
    }

    private async Task ExportDailyExpenses() => await ExpenseService.ExportDailyExpenses(_dateToGetDailyExpenses);
    private async Task ImportExpenses() => await ExpenseService.ImportExpenses();

    private async Task ImportDailyExpenses()
    {
        var imported = await ExpenseService.ImportDailyExpenses(_dateToGetDailyExpenses);
        if (!imported)
        {
            Console.WriteLine("Import cancelled");
            return;
        }
        var dailyExpenses = await ExpenseService.GetDailyExpenses(_dateToGetDailyExpenses);
        if (dailyExpenses != null)
        {
            _disabledExpensesNames.RemoveWhere(x => dailyExpenses.Any(e => e.Name == x.Name));
            _currentDailyExpense = dailyExpenses;

            foreach (var expense in _currentDailyExpense)
            {
                _disabledExpensesNames.Add(expense);
            }
        }
        else
        {
            Console.WriteLine("No daily expenses found");
        }
        _setHeight = true;
    }

}